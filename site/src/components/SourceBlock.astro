---
/**
 * Kaynak/atıf bloğu. Finans içeriğinde E-E-A-T'nin görünür kanıtı.
 * Her sayısal iddia birincil kaynağa ve erişim tarihine bağlanır.
 */
import { tarih } from "../lib/format";

export interface Kaynak {
  ad: string;
  url?: string;
  erisim: string; // ISO tarih
}

interface Props {
  kaynaklar: Kaynak[];
  yontem?: string;
}

const { kaynaklar, yontem } = Astro.props;
---

<section class="kaynaklar" aria-labelledby="kaynaklar-baslik">
  <h2 id="kaynaklar-baslik" class="kaynaklar__baslik">Kaynaklar ve yöntem</h2>

  {yontem && <p class="kaynaklar__yontem">{yontem}</p>}

  <ol class="kaynaklar__liste">
    {kaynaklar.map((k) => (
      <li>
        {k.url ? <a href={k.url} rel="noopener">{k.ad}</a> : <span>{k.ad}</span>}
        <span class="kaynaklar__erisim"> — erişim: <time datetime={k.erisim}>{tarih(k.erisim)}</time></span>
      </li>
    ))}
  </ol>
</section>

<style>
  .kaynaklar {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-6);
    margin-top: var(--space-12);
  }
  .kaynaklar__baslik {
    font-size: var(--text-h4);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-3);
  }
  .kaynaklar__yontem {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  .kaynaklar__liste {
    font-size: var(--text-sm);
    line-height: 1.6;
    padding-left: var(--space-6);
    margin: 0;
  }
  .kaynaklar__liste li + li { margin-top: var(--space-2); }
  .kaynaklar__erisim { color: var(--color-text-secondary); }
</style>
